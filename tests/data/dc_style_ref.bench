# Hand-written reference for dc_style.v
INPUT(rst_n)
INPUT(en)
INPUT(a)
INPUT(b)
INPUT(sel)
INPUT(si)
INPUT(se)
OUTPUT(cnt[1])
OUTPUT(cnt[0])
OUTPUT(y)
OUTPUT(co)
OUTPUT(qn_out)
cnt[0] = DFF(n1)
cnt[1] = DFF(n3)
qn_out = DFF(sd)
n2 = NOT(cnt[0])
n1 = XOR(cnt[0], en)
n5 = AND(cnt[0], en)
n3 = XOR(cnt[1], n5)
bn2 = AND(b, n2)
n6 = NOR(a, bn2)
nse = NOT(se)
s1 = AND(se, si)
s0 = AND(nse, n6)
sd = OR(s1, s0)
one = CONST1()
y = MUX(sel, n6, one)
co = AND(a, b)
